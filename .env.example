# Frontend API Configuration
# Copy this to .env.local for local development.
# Leave VITE_API_BASE_URL empty on a single Render Web Service so requests use the same origin.

# Local development
VITE_API_BASE_URL=http://localhost:5000
VITE_SITE_URL=https://universeconsults.netlify.app

# Backend configuration for local development or Render
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=educon
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_BOOTSTRAP_NAME=Super Admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Only needed if your frontend and backend are hosted on different domains.
# CORS_ORIGINS=https://your-frontend-domain.com

# Google OpenID Connect (backend only; never expose the client secret to Vite)
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/student/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Resend email delivery (backend only; never expose these to Vite)
RESEND_API_KEY=re_placeholder_only
EMAIL_FROM=Universe Consult <no-reply@your-domain.com>
EMAIL_VERIFICATION_CODE_PEPPER=replace-with-a-long-random-secret
