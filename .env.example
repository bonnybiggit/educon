# Frontend API Configuration
# Copy this to .env.local for local development.
# Leave VITE_API_BASE_URL empty on a single Render Web Service so requests use the same origin.

# Local development
VITE_API_BASE_URL=http://localhost:5000

# Backend configuration for local development or Render
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=educon
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_BOOTSTRAP_NAME=Super Admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Only needed if your frontend and backend are hosted on different domains.
# CORS_ORIGINS=https://your-frontend-domain.com
