# Frontend API Configuration
# Copy this to .env.local for local development
# For Netlify, set these in the Netlify dashboard under Site Settings > Build & Deploy > Environment

# Local development
VITE_API_BASE_URL=http://localhost:5000

# For production on Netlify, use your deployed backend URL:
# VITE_API_BASE_URL=https://your-backend-api.herokuapp.com
# or
# VITE_API_BASE_URL=https://your-backend-api.render.com
