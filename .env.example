# Local frontend configuration. Production uses same-origin /api requests.
VITE_API_BASE_URL=http://localhost:5000
VITE_SITE_URL=https://universeconsultsedu.com

# Backend configuration
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/educon?retryWrites=true&w=majority&appName=educon1
MONGODB_DB_NAME=educon
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN_SECONDS=28800
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=

# Optional admin creation. Existing admin accounts are never updated by startup.
# ADMIN_BOOTSTRAP_NAME=Super Admin
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Optional Google OAuth. Configure all three values to enable it.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/student/auth/google/callback

# Optional email verification. Requires all three values to enable delivery.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Universe Consult <support@universeconsultsedu.com>
EMAIL_VERIFICATION_CODE_PEPPER=replace-with-a-separate-random-secret
