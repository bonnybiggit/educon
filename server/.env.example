# Copy this file to server/.env and replace the values before starting the backend.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=educon
MONGODB_STUDENTS_COLLECTION=students
MONGODB_ADMINS_COLLECTION=admins
MONGODB_ENQUIRIES_COLLECTION=enquiries
MONGODB_ACTIVITY_LOGS_COLLECTION=activityLogs
PORT=5000
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=28800
ADMIN_COOKIE_NAME=educon_admin_token
ADMIN_BOOTSTRAP_NAME=Super Admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
