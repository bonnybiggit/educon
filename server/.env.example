# Copy to server/.env for local development. Never commit actual environment files.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<url-encoded-username>:<url-encoded-password>@<cluster-host>/educon?retryWrites=true&w=majority
MONGODB_DB_NAME=educon
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN_SECONDS=28800
ADMIN_COOKIE_NAME=educon_admin_token
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=

# Optional admin creation. Existing admin accounts are never updated by startup.
# ADMIN_BOOTSTRAP_NAME=Super Admin
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=use-a-unique-password-at-least-12-characters

# Optional email verification. Requires all three values to enable delivery.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Universe Consult <support@universeconsultsedu.com>
SUPPORT_NOTIFICATION_EMAIL=support@universeconsultsedu.com
EMAIL_VERIFICATION_CODE_PEPPER=generate-a-separate-random-secret
