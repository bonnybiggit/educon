# Copy to server/.env for local development. Never commit actual environment files.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<url-encoded-username>:<url-encoded-password>@<cluster-host>/educon?retryWrites=true&w=majority
MONGODB_DB_NAME=educon
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN_SECONDS=28800
ADMIN_COOKIE_NAME=educon_admin_token

# Admin session security (JWT_EXPIRES_IN_SECONDS above keeps controlling student sessions only).
ADMIN_SESSION_TTL_SECONDS=7200
ADMIN_IDLE_TIMEOUT_SECONDS=1800
# Rollout: while not "false", admin tokens issued before this upgrade (no session id) are still accepted,
# but ONLY if ADMIN_LEGACY_TOKEN_UNTIL is set to an explicit absolute ISO date. If it is unset or invalid,
# legacy tokens are rejected (restarting the server never extends the window). Tokens issued after that
# instant are never accepted as legacy. Choose a date no later than ADMIN_SESSION_TTL_SECONDS-old tokens allow.
# After the rollout is verified, set ADMIN_LEGACY_TOKEN_COMPAT=false.
ADMIN_LEGACY_TOKEN_COMPAT=true
# ADMIN_LEGACY_TOKEN_UNTIL=2026-12-31T00:00:00Z
# Admin Bearer-token authentication is rejected unless this is exactly "true" (browser sessions use the cookie).
ADMIN_ALLOW_BEARER=false

# Admin security alert emails (sent to the affected account's own stored email; never include secrets).
ADMIN_SECURITY_ALERTS_ENABLED=true
# Failed sign-ins (across all IPs, 15-minute window) before one alert is sent.
ADMIN_LOGIN_ALERT_THRESHOLD=5
# Minimum seconds between failed-login alerts per account (floor: 3600).
ADMIN_ALERT_COOLDOWN_SECONDS=3600
# Admin password recovery and alerts need RESEND_API_KEY, EMAIL_FROM and EMAIL_VERIFICATION_CODE_PEPPER below.

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of Node (Listed Hosting / cPanel). The hop count is NOT verified:
# confirm it by logging req.ip from a known client before relying on it. Too LOW makes every visitor share
# the proxy's IP (one rate-limit bucket); too HIGH lets clients spoof X-Forwarded-For. Defaults to 1 in production.
TRUST_PROXY=

# Optional admin creation. Existing admin accounts are never updated by startup.
# ADMIN_BOOTSTRAP_NAME=Super Admin
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=use-a-unique-password-at-least-12-characters

# Optional email verification. Requires all three values to enable delivery.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Universe Consult <support@universeconsultsedu.com>
SUPPORT_NOTIFICATION_EMAIL=support@universeconsultsedu.com
EMAIL_VERIFICATION_CODE_PEPPER=generate-a-separate-random-secret
